{
  "name": "@doodesch/sideload-vite",
  "version": "1.0.1",
  "type": "module",
  "description": "Build a Sideload app with Vite: React or plain TypeScript in, one bundle the engine reads out.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lowering": "./lowering.js",
    "./types": "./types/sideload.d.ts"
  },
  "files": [
    "index.js",
    "lowering.js",
    "types",
    "README.md"
  ],
  "scripts": {
    "gen": "node gen-types.mjs",
    "check": "tsc -p example && node example/verify.mjs",
    "example": "cd example && vite build",
    "types": "tsc -p example",
    "types:check": "node gen-types.mjs --check"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "dependencies": {
    "lightningcss": "1.33.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "sideload",
    "schedule-i",
    "melonloader",
    "vite-plugin",
    "modding"
  ],
  "homepage": "https://github.com/DooDesch-Mods/ScheduleOne-Sideload#readme",
  "bugs": {
    "url": "https://support.doodesch.de/sideload"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DooDesch-Mods/ScheduleOne-Sideload.git",
    "directory": "tools/sideload-vite"
  },
  "author": "DooDesch",
  "publishConfig": {
    "access": "public"
  }
}
