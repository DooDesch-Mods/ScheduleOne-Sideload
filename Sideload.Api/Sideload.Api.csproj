<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sideload.Api - the modder-facing no-op shim for the Sideload phone-app framework.
    A tiny, self-contained netstandard2.0 assembly with ZERO references (no MelonLoader, IL2CPP or Unity). A modder
    either references this DLL or drops the single Sideload.cs file into their own project. It locates the running
    Sideload host by reflection (Sideload.Bridge.SideloadBridge) and binds standard BCL delegates - so it shares
    NO type with the host and is a true zero-overhead no-op when Sideload is not installed. Usage:
    Sideload.Api.Apps.Register("prophunt", "PropHunt.App", title: "PropHunt", iconLabel: "PropHunt");
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Sideload.Api</RootNamespace>
    <AssemblyName>Sideload.Api</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    Keep the shipped copy of the shim in step with this one.

    Mods that live in their own repository have no sibling Sideload.Api/ folder; their CI checks the build-libs
    repo out as ./Workspace and compiles Workspace/lib/sideload-api/Sideload.cs instead. That copy going stale is
    not a soft failure - the dependent mod calls a method the copy has never heard of and the RELEASE build breaks,
    on a machine nobody is looking at, after the tag has been pushed. Which is exactly what happened to
    Orientation(...) once and to SurfaceHandle again.

    Copying it here means the only way to leave it stale is to not build this project at all. Pushing it is still
    manual, and still the step to remember.
  -->
  <Target Name="RefreshShippedShim" AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)../../Workspace/lib/sideload-api')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Sideload.cs"
          DestinationFolder="$(MSBuildThisFileDirectory)../../Workspace/lib/sideload-api"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
